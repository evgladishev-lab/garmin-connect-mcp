{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/drive-smoke.js": {
      "maxDuration": 30
    },
    "api/garmin-sync.js": {
      "maxDuration": 120
    },
    "api/garmin-scheduled.js": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "garmin-daily": {
      "schedule": "0 9 * * *",
      "timezone": "Asia/Novosibirsk",
      "function": "api/garmin-scheduled"
    }
  }
}
